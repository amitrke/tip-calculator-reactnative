{
  "name": "tip-calculator-reactnative",
  "version": "3.8.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "release-it": "release-it",
    "test": "echo \"No tests specified\" && exit 0",
    "maestro:studio": "maestro studio",
    "maestro:test:android": "./maestro/run_maestro_tests.sh android",
    "maestro:test:ios": "./maestro/run_maestro_tests.sh ios",
    "screenshots": "maestro test maestro/ --test-output-dir maestro",
    "organize:screenshots": "./organize_screenshots.sh",
    "build:android:local": "eas build -p android --profile preview --local",
    "build:android:cloud": "eas build -p android --profile production",
    "build:ios:local": "eas build -p ios --profile preview --local",
    "build:ios:cloud": "eas build -p ios --profile production",
    "build:all:local": "npm run build:android:local && npm run build:ios:local",
    "build:all:cloud": "npm run build:android:cloud && npm run build:ios:cloud"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.13",
    "@expo/vector-icons": "15.1.1",
    "@gluestack-style/react": "^1.0.57",
    "@gluestack-ui/config": "^1.1.18",
    "@gluestack-ui/themed": "^1.1.22",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/cli": "20.1.3",
    "@react-native-community/masked-view": "^0.1.11",
    "@react-navigation/bottom-tabs": "7.16.2",
    "@react-navigation/native": "7.2.5",
    "@react-navigation/stack": "7.9.3",
    "expo": "^56.0.5",
    "expo-font": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "lucide-react-native": "1.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3",
    "styled-components": "6.4.2",
    "styled-system": "^5.1.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.14",
    "typescript": "~6.0.3"
  },
  "private": true
}
